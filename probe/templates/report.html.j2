<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Probe Run Report — {{ snapshot.version }} {{ snapshot.build }}</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',system-ui,sans-serif;font-size:14px;background:#f8fafc;color:#1e293b;line-height:1.5}
.container{max-width:1100px;margin:0 auto;padding:24px 16px}
h1{font-size:1.4rem;font-weight:700;margin-bottom:4px}
.subtitle{color:#64748b;font-size:.85rem;margin-bottom:24px}
.header-meta{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:24px;padding:16px;background:#fff;border:1px solid #e2e8f0;border-radius:10px}
.meta-item{display:flex;flex-direction:column}
.meta-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;font-weight:600}
.meta-value{font-size:.9rem;font-weight:500}
.toc{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:24px}
.toc h2{font-size:.85rem;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;font-weight:600;margin-bottom:8px}
.toc ul{list-style:none;padding:0;columns:2}
.toc li{margin-bottom:2px}
.toc a{color:#6366f1;text-decoration:none;font-size:.82rem}
.toc a:hover{text-decoration:underline}
.path-group{background:#fff;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:16px;overflow:hidden}
.path-heading{padding:12px 16px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;font-family:monospace;font-size:.9rem;font-weight:600;color:#334155}
.method-block{padding:16px;border-bottom:1px solid #f1f5f9}
.method-block:last-child{border-bottom:none}
.method-row{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.method-badge{font-size:.72rem;font-weight:700;padding:3px 8px;border-radius:5px;text-transform:uppercase;font-family:monospace}
.GET{background:#dcfce7;color:#166534}
.POST{background:#dbeafe;color:#1d4ed8}
.PUT{background:#fef9c3;color:#854d0e}
.DELETE{background:#fee2e2;color:#991b1b}
.badge-deprecated{background:#fff7ed;color:#c2410c;border:1px solid #fdba74;font-size:.72rem;padding:2px 8px;border-radius:5px}
.status-badge{background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;font-size:.72rem;padding:2px 8px;border-radius:5px;font-family:monospace}
.scenario-label{background:#ede9fe;color:#5b21b6;font-size:.7rem;padding:2px 8px;border-radius:5px}
.flag-badge{background:#fff1f2;color:#be123c;border:1px solid #fecdd3;font-size:.7rem;padding:2px 8px;border-radius:5px}
.section-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;font-weight:600;margin:12px 0 6px}
table{width:100%;border-collapse:collapse;font-size:.82rem;margin-bottom:12px}
th{text-align:left;padding:6px 10px;background:#f8fafc;border-bottom:2px solid #e2e8f0;color:#64748b;font-weight:600;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}
td{padding:6px 10px;border-bottom:1px solid #f1f5f9}
tr:last-child td{border-bottom:none}
.req-yes{color:#166534;font-weight:600}
.req-no{color:#94a3b8}
.pres-always{color:#166534}
.pres-sometimes{color:#92400e}
pre{background:#1e293b;color:#e2e8f0;padding:12px;border-radius:8px;font-size:.78rem;overflow-x:auto;white-space:pre-wrap;word-break:break-word;max-height:300px;overflow-y:auto}
.scenario-diff{background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:12px;margin-top:8px}
.scenario-diff-title{font-size:.78rem;color:#92400e;font-weight:600;margin-bottom:8px}
.diff-cols{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:600px){.diff-cols{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="container">
  <h1>Probe Run Report</h1>
  <p class="subtitle">{{ snapshot.version }} · {{ snapshot.build }} · {{ snapshot.captured_at }}</p>

  <div class="header-meta">
    <div class="meta-item"><span class="meta-label">Version</span><span class="meta-value">{{ snapshot.version }}</span></div>
    <div class="meta-item"><span class="meta-label">Build</span><span class="meta-value">{{ snapshot.build }}</span></div>
    <div class="meta-item"><span class="meta-label">Run ID</span><span class="meta-value">{{ snapshot.run_id }}</span></div>
    <div class="meta-item"><span class="meta-label">Captured</span><span class="meta-value">{{ snapshot.captured_at }}</span></div>
    <div class="meta-item"><span class="meta-label">Base URL</span><span class="meta-value">{{ snapshot.base_url }}</span></div>
    <div class="meta-item"><span class="meta-label">Registry v</span><span class="meta-value">{{ snapshot.registry.registry_version }}</span></div>
    <div class="meta-item"><span class="meta-label">Working endpoints</span><span class="meta-value">{{ working_count }}</span></div>
  </div>

  <div class="toc">
    <h2>Working Endpoints</h2>
    <ul>
      {% for group in groups %}
      <li><a href="#path-{{ loop.index }}">{{ group.path }}</a></li>
      {% endfor %}
    </ul>
  </div>

  {% if trace_entries %}
  <style>
    .trace-outer{background:#fff;border:1px solid #e2e8f0;border-radius:10px;margin-bottom:24px;overflow:hidden}
    .trace-outer-summary{padding:12px 16px;background:#f1f5f9;border-bottom:1px solid #e2e8f0;cursor:pointer;font-size:.85rem;font-weight:600;color:#334155;list-style:none;display:flex;align-items:center;gap:8px;user-select:none}
    .trace-outer-summary::-webkit-details-marker{display:none}
    .trace-filter-bar{display:flex;gap:8px;align-items:center;padding:12px 16px;border-bottom:1px solid #f1f5f9}
    .trace-filter-bar input{flex:1;padding:6px 10px;border:1px solid #e2e8f0;border-radius:6px;font-size:.82rem;font-family:monospace;outline:none}
    .trace-filter-bar input:focus{border-color:#6366f1}
    .trace-entry{border-bottom:1px solid #f1f5f9}
    .trace-entry:last-child{border-bottom:none}
    .trace-entry-summary{padding:9px 16px;cursor:pointer;list-style:none;display:flex;align-items:center;gap:10px;user-select:none}
    .trace-entry-summary::-webkit-details-marker{display:none}
    .trace-entry-summary:hover{background:#f8fafc}
    .trace-arrow{font-size:.7rem;color:#94a3b8;width:1rem;flex-shrink:0}
    .trace-num{font-size:.72rem;color:#94a3b8;width:2rem;flex-shrink:0;text-align:right}
    .trace-ts{font-size:.72rem;font-family:monospace;color:#94a3b8;white-space:nowrap;flex-shrink:0}
    .trace-url{font-family:monospace;font-size:.8rem;color:#334155;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;flex:1}
    .trace-status{font-family:monospace;font-size:.78rem;font-weight:700;flex-shrink:0}
    .trace-status.ok{color:#166534}
    .trace-status.redir{color:#92400e}
    .trace-status.err{color:#991b1b}
    .trace-status.none{color:#94a3b8}
    .trace-panel{padding:12px 16px 16px;background:#fafafa;border-top:1px solid #f1f5f9;display:grid;grid-template-columns:1fr 1fr;gap:16px}
    @media(max-width:760px){.trace-panel{grid-template-columns:1fr}}
    .trace-side-label{font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;font-weight:600;margin-bottom:6px}
    .trace-section{margin-bottom:10px}
    .trace-section:last-child{margin-bottom:0}
    .trace-field-label{font-size:.7rem;text-transform:uppercase;letter-spacing:.05em;color:#94a3b8;font-weight:600;margin-bottom:3px}
    .trace-pre{background:#1e293b;color:#e2e8f0;padding:10px;border-radius:6px;font-size:.75rem;overflow:auto;max-height:220px;white-space:pre-wrap;word-break:break-word;margin:0}
    .trace-none{font-size:.78rem;color:#94a3b8;font-style:italic}
    .trace-error{font-size:.78rem;color:#be123c;font-weight:600}
  </style>
  <div style="background:#fffbeb;border:2px solid #f59e0b;border-radius:10px;padding:10px 16px;margin-bottom:16px;font-size:.82rem;color:#92400e;font-weight:600">
    ⚠ Trace mode — {{ trace_entries|length }} requests captured. Authorization tokens are truncated.
  </div>
  <div class="trace-outer">
    <details id="trace-outer-details" open>
      <summary class="trace-outer-summary">
        <span id="trace-outer-arrow">▼</span>
        <span>Full Request Trace — {{ trace_entries|length }} requests</span>
        <span style="font-size:.72rem;font-weight:400;color:#64748b;margin-left:auto">Click to collapse</span>
      </summary>
      <div class="trace-filter-bar">
        <input id="trace-filter" type="text" placeholder="Filter by URL or method…" oninput="filterTrace(this.value)">
        <span id="trace-count" style="font-size:.78rem;color:#94a3b8;white-space:nowrap">{{ trace_entries|length }} shown</span>
      </div>
      <div id="trace-list">
        {% for e in trace_entries %}
        <div class="trace-entry" data-url="{{ e.url }}" data-method="{{ e.method }}">
          <details>
            <summary class="trace-entry-summary">
              <span class="trace-arrow">▶</span>
              <span class="trace-num">{{ e.n }}</span>
              <span class="method-badge {{ e.method }}">{{ e.method }}</span>
              {% if e.retry > 0 %}<span class="flag-badge">retry {{ e.retry }}</span>{% endif %}
              <span class="trace-url" title="{{ e.url }}">{{ e.url }}</span>
              <span class="trace-ts">{{ e.ts }}</span>
              <span class="trace-status {% if e.status is none %}none{% elif e.status < 300 %}ok{% elif e.status < 400 %}redir{% else %}err{% endif %}">
                {{ e.status if e.status is not none else '—' }}
              </span>
            </summary>
            <div class="trace-panel">
              <div>
                <div class="trace-side-label">Request</div>
                {% if e.error %}
                <div class="trace-section">
                  <div class="trace-field-label">Connection Error</div>
                  <div class="trace-error">{{ e.error }}</div>
                </div>
                {% endif %}
                <div class="trace-section">
                  <div class="trace-field-label">Headers</div>
                  {% if e.req_headers_str %}
                  <pre class="trace-pre">{{ e.req_headers_str }}</pre>
                  {% else %}<span class="trace-none">none</span>{% endif %}
                </div>
                <div class="trace-section">
                  <div class="trace-field-label">Body</div>
                  {% if e.req_body_str %}
                  <pre class="trace-pre">{{ e.req_body_str }}</pre>
                  {% else %}<span class="trace-none">none</span>{% endif %}
                </div>
              </div>
              <div>
                <div class="trace-side-label">Response</div>
                <div class="trace-section">
                  <div class="trace-field-label">Headers</div>
                  {% if e.resp_headers_str %}
                  <pre class="trace-pre">{{ e.resp_headers_str }}</pre>
                  {% else %}<span class="trace-none">none</span>{% endif %}
                </div>
                <div class="trace-section">
                  <div class="trace-field-label">Body</div>
                  {% if e.resp_body_str %}
                  <pre class="trace-pre">{{ e.resp_body_str }}</pre>
                  {% else %}<span class="trace-none">none</span>{% endif %}
                </div>
              </div>
            </div>
          </details>
        </div>
        {% endfor %}
      </div>
    </details>
  </div>
  <script>
    function filterTrace(q) {
      q = q.toLowerCase();
      var entries = document.querySelectorAll('#trace-list .trace-entry');
      var shown = 0;
      entries.forEach(function(e) {
        var match = !q || e.dataset.url.toLowerCase().includes(q) || e.dataset.method.toLowerCase().includes(q);
        e.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      document.getElementById('trace-count').textContent = shown + ' shown';
    }
    document.getElementById('trace-outer-details').addEventListener('toggle', function() {
      document.getElementById('trace-outer-arrow').textContent = this.open ? '▼' : '▶';
    });
    document.querySelectorAll('#trace-list .trace-entry details').forEach(function(d) {
      d.addEventListener('toggle', function() {
        this.querySelector('.trace-arrow').textContent = this.open ? '▼' : '▶';
      });
    });
  </script>
  {% endif %}

  {% for group in groups %}
  <div class="path-group" id="path-{{ loop.index }}">
    <div class="path-heading">{{ group.path }}</div>
    {% for method_data in group.methods %}
    <div class="method-block">
      {% for scenario in method_data.scenarios %}
      <div class="method-row">
        <span class="method-badge {{ method_data.method }}">{{ method_data.method }}</span>
        {% if scenario.deprecated %}<span class="badge-deprecated">Deprecated {{ scenario.deprecated.in }}</span>{% endif %}
        <span class="status-badge">{{ scenario.status }}</span>
        {% for s in scenario.scenarios %}<span class="scenario-label">{{ s }}</span>{% endfor %}
        {% for flag in scenario.registry_flags %}<span class="flag-badge">{{ flag }}</span>{% endfor %}
      </div>

      {% if scenario.request_fields %}
      <div class="section-label">Request Fields</div>
      <table>
        <thead><tr><th>Field</th><th>Type</th><th>Required</th></tr></thead>
        <tbody>
          {% for field, info in scenario.request_fields.items() %}
          <tr>
            <td><code>{{ field }}</code></td>
            <td>{{ info.type }}</td>
            <td class="{{ 'req-yes' if info.required else 'req-no' }}">{{ 'required' if info.required else 'optional' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if scenario.registry_body %}
      <div class="section-label">Example Request Body</div>
      <pre>{{ scenario.registry_body }}</pre>
      {% endif %}

      {% if scenario.response_schema %}
      <div class="section-label">Response Fields</div>
      <table>
        <thead><tr><th>Field</th><th>Type</th><th>Format</th><th>Presence</th></tr></thead>
        <tbody>
          {% for field, info in scenario.response_schema.items() %}
          <tr>
            <td><code>{{ field }}</code></td>
            <td>{{ info.type }}</td>
            <td>{{ info.format or '—' }}</td>
            <td class="{{ 'pres-always' if info.required else 'pres-sometimes' }}">{{ 'always' if info.required else 'sometimes' }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      {% if scenario.example_response %}
      <div class="section-label">Example Response</div>
      <pre>{{ scenario.example_response }}</pre>
      {% endif %}

      {% if not loop.last %}<hr style="border:none;border-top:1px dashed #e2e8f0;margin:12px 0">{% endif %}
      {% endfor %}

      {% if method_data.has_scenario_diff %}
      <div class="scenario-diff">
        <div class="scenario-diff-title">⚠ Response differs by scenario</div>
        <div class="diff-cols">
          {% for scenario in method_data.scenarios %}
          <div>
            <div class="section-label">{{ scenario.scenarios | join(' + ') }}</div>
            <p style="font-size:.82rem">Status: <strong>{{ scenario.status }}</strong></p>
          </div>
          {% endfor %}
        </div>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

</div>
</body>
</html>
